generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ENGINEER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  messages            Message[]
  pricingRateEdits    PricingRate[] @relation("PricingRateEditedBy")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Custom — Credentials-based auth has no built-in reset flow, so this is our own.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum PricingCategory {
  TOOLING
  BASE
  COPPER_THICKNESS
  SURFACE_FINISH
  SUBSTRATE_THICKNESS
  LEAD_TIME
  QTY_SLAB
  PANELIZATION
}

// One row = one resolvable rate for one (category, key) pair. Single generic
// table (not 7 separate ones) so the admin UI is one CRUD screen with a
// category filter, and adding a future pricing dimension is a new enum value
// + rows, not a new table + new API route.
model PricingRate {
  id          String          @id @default(cuid())
  category    PricingCategory
  key         String // e.g. "2" (layers), "ENIG" (finish), "2 oz" (copper), "1.6mm" (thickness), "express", "100" (qty slab)
  label       String // human-readable label for the admin UI
  value       Decimal         @db.Decimal(10, 2) // meaning depends on unit: flat INR, INR/cm2, or a percent
  unit        String // "INR_FLAT" | "INR_PER_CM2" | "PERCENT_SURCHARGE" | "PERCENT_DISCOUNT"
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  updatedAt   DateTime        @updatedAt
  updatedById String?
  updatedBy   User?           @relation("PricingRateEditedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([category, key])
  @@map("pricing_rates")
}

enum OrderStatus {
  QUOTE
  PENDING_REVIEW
  AWAITING_PAYMENT
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  CANCELLED
}

// How the fabricated boards should be delivered:
// - INDIVIDUAL: single boards, no panelization (default, existing behavior)
// - PANEL_BY_CUSTOMER: customer supplies an already-panelized Gerber set
// - PANEL_BY_PROPCB: we panelize on the customer's behalf, for a fixed fee
//   (PricingRate category PANELIZATION, admin-editable)
enum DeliveryFormat {
  INDIVIDUAL
  PANEL_BY_CUSTOMER
  PANEL_BY_PROPCB
}

model Order {
  id             String         @id @default(cuid())
  reference      String         @unique // short human-facing ref (id prefix, uppercased)
  userId         String
  status         OrderStatus    @default(QUOTE)
  deliveryFormat DeliveryFormat @default(INDIVIDUAL)

  fileName     String?
  widthMm      Decimal     @db.Decimal(10, 2)
  heightMm     Decimal     @db.Decimal(10, 2)
  layers       String
  qty          Int
  finish       String
  color        String
  copperWeight String
  thickness    String
  express      Boolean     @default(false)

  // Snapshot of the resolved price breakdown at order time — historical
  // orders must NOT silently reprice when an admin edits a PricingRate later.
  priceBreakdown Json
  total          Decimal @db.Decimal(10, 2) // denormalized for cheap sort/filter

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  messageThread MessageThread?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

enum ThreadType {
  ORDER
  GENERAL_INQUIRY
}

model MessageThread {
  id          String     @id @default(cuid())
  type        ThreadType @default(ORDER)
  orderId     String?    @unique
  subject     String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt // bumped on every new message, for "most recently active" sort

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("message_threads")
}

model Message {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  readAt    DateTime?

  // One image attachment per message (screenshots) — stored on local disk
  // for now (see src/lib/attachments.ts), path is relative to the upload
  // root and includes the threadId so access-control can be checked from
  // the path alone without a DB round trip in the serving route.
  attachmentPath String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("messages")
}
