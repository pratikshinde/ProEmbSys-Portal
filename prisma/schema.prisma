generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ENGINEER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  // Deactivated staff can't log in, but their name/message history in
  // shared order threads stays intact — never hard-delete a staff account,
  // since Message.authorId cascades on delete and would erase their side
  // of past customer conversations.
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  messages            Message[]
  pricingRateEdits    PricingRate[]        @relation("PricingRateEditedBy")
  addresses           Address[]
  blogPosts           BlogPost[]
  shopOrders          ShopOrder[]
  dfmTemplates        DfmTemplate[]
  panelTemplates      PanelTemplate[]
  camJobs             CamJob[]
  contacts            Contact[]
  shareBundles        ShareBundle[]

  @@map("users")
}

enum AddressType {
  BILLING
  DELIVERY
}

// A customer's saved address book — multiple per type, one flagged default
// per type. GST registration in India is tied to a specific place of
// business, so `gstNumber` lives on the (billing) address, not the User.
model Address {
  id         String      @id @default(cuid())
  userId     String
  type       AddressType
  label      String? // friendly name, e.g. "Head Office", "Warehouse 2"
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String      @default("India")
  gstNumber  String? // relevant for BILLING addresses
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

enum ContactScope {
  PRIVATE
  SHARED
}

// Saved recipients for the CAM Sharing feature (film plotter / drill shop /
// test house contacts) — an address-book clone, same PRIVATE/SHARED split
// as DfmTemplate/PanelTemplate, but with ONE deliberate divergence: SHARED
// here is staff-visible only, never public. A DfmTemplate's SHARED row is
// meant for every customer to use (so the CAM tool works logged-out); a
// SHARED Contact is an org-wide address book entry (e.g. "Drill Dept,
// ProEmbSys") that only staff should be able to pick when sending fab work
// out — a customer emailing their own board should never see, or be able
// to email, another customer's shop contact. See visibleContactsWhere in
// src/lib/contacts.ts, which is its own helper (not a reuse of
// visibleTemplatesWhere) for exactly this reason.
model Contact {
  id      String       @id @default(cuid())
  scope   ContactScope @default(PRIVATE)
  userId  String? // owner of a PRIVATE contact; null for org-wide SHARED
  name    String
  email   String
  company String?
  role    String? // free text: "Film plotter", "Drill shop", "Test house", ...
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareRecipients ShareRecipient[]

  // Postgres treats NULLs as distinct in a unique index, so this dedupes
  // PRIVATE contacts (userId set — the case that matters, since users
  // re-add the same plotter/drill-shop email repeatedly) but NOT SHARED
  // ones (userId null — those are admin-curated, not auto-deduped).
  @@unique([userId, email])
  @@index([userId])
  @@index([scope])
  @@map("contacts")
}

enum ShareBundleKind {
  FILM
  DRILL
  TEST
}

// One emailed bundle of CAM output files, sent to N recipients. Separate
// from CamJob (not a field on it) because outputs are NOT a function of the
// job alone — the same job exported twice with a different filmConfig or
// routing plan produces different bytes, and a bundle is immutable once
// sent while a CamJob is mutable work-in-progress. camJobId is REQUIRED
// (not optional): a share with no job behind it is unreproducible — you
// could never answer "which job did this film go out from" or regenerate
// it — and it gives retention/cleanup a natural owner (deleting a job
// cascades its bundles). orderId is optional, same "not every job is
// commercial work" reasoning as CamJob.orderId.
//
// One bundle = one kind = one ZIP = N recipients. "Send film + drill"
// creates TWO bundles, never one bundle with a mixed manifest — kind
// selects both the file filter and the email template, so it belongs on
// the bundle, not folded into a list.
model ShareBundle {
  id       String          @id @default(cuid())
  userId   String
  camJobId String
  orderId  String?
  kind     ShareBundleKind

  fileName String
  fileSize Int
  // FilmManifest | DrillManifest | TestManifest (src/lib/share/manifest.ts)
  // — the SAME structured object that rendered the in-ZIP README also
  // drives the email body, so the two can never say different things.
  manifest Json
  message  String?

  // 30 days default, extendable/revocable from the job's share history —
  // never "forever" (unbounded disk growth) and never "delivery receipt
  // proof" (see ShareRecipient.firstAccessedAt's own comment on why a
  // corporate link scanner can fire that before any human sees the link).
  expiresAt DateTime
  createdAt DateTime @default(now())

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  camJob     CamJob           @relation(fields: [camJobId], references: [id], onDelete: Cascade)
  order      Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  recipients ShareRecipient[]

  @@index([userId])
  @@index([camJobId])
  // Drives the lazy expiry sweep (share/sweep.ts) — a range scan, not a
  // point lookup, so this index matters even though nothing else queries
  // by expiresAt alone.
  @@index([expiresAt])
  @@map("share_bundles")
}

// One recipient of one ShareBundle, with their own token — per-recipient
// (not one token per bundle) so a single leaked/compromised link can be
// revoked without breaking delivery to everyone else, and so a forward is
// attributable to whoever it was actually sent to.
model ShareRecipient {
  id        String  @id @default(cuid())
  bundleId  String
  contactId String?

  // Snapshotted, not read live through contactId — same reasoning as
  // Order.deliveryAddress/billingAddress: editing or deleting a Contact
  // later must never change what a past send says it went to.
  email String
  name  String?

  // 32 random bytes, hex — plaintext, a deliberate decision (not a silent
  // inheritance from PasswordResetToken): a share link must be
  // re-displayable ("copy link") and resend must reuse the SAME link, so
  // there's nothing to hash against. Unlike PasswordResetToken this token
  // is also NOT single-use (see revokedAt below) — a 30-day link a plotter
  // opens on their phone and then again at the shop PC must keep working.
  token String @unique

  sentAt    DateTime?
  // null = delivered to Resend OK. Set = exactly why this ONE recipient's
  // send failed — the bundle and every OTHER recipient's link still
  // persist regardless (see the "per-recipient partial success" policy in
  // src/lib/email.ts), so a retry only needs to resend to this recipient.
  sendError String?
  // Whether the ZIP was attached to this recipient's email (small enough)
  // or the recipient must use the link — both cases keep the link in the
  // email either way, this is purely informational for the UI.
  attached  Boolean   @default(false)

  // NOT proof a human opened the link — corporate link-scanners (Defender
  // SafeLinks, Proofpoint, etc.) fetch a URL before any person sees it, so
  // this can fire seconds after send for mail nobody read. Useful for
  // "was this link ever accessed at all", not "did they see it". The UI
  // must say "link accessed", never "so-and-so opened it".
  firstAccessedAt DateTime?
  lastAccessedAt  DateTime?
  accessCount     Int       @default(0)

  // Deliberately NOT `usedAt` — see `token`'s own comment: this link is
  // multi-use, so revocation is the only way to kill it early.
  revokedAt DateTime?

  createdAt DateTime @default(now())

  bundle  ShareBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  contact Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([bundleId])
  @@map("share_recipients")
}

// DB-backed rate limiter for POST /api/share — the app's first
// abuse-sensitive endpoint (email + disk write, triggerable by any signed-in
// user). Deliberately not generic middleware: middleware.ts only matches
// /admin/:path*, and pulling /api/** into the Edge matcher risks the
// documented auth.config/Prisma split (middleware must stay Edge-safe, this
// counter needs a real DB round trip). Keys are "user:<id>:<yyyymmddhh>" and
// "global:<yyyymmddhh>" — incremented via an atomic upsert inside a
// transaction, the same rule CLAUDE.md already codifies for OrderSequence
// ("never derive the count by reading then writing — concurrent requests
// would race and collide").
model ShareRateCounter {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@map("share_rate_counters")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Custom — Credentials-based auth has no built-in reset flow, so this is our own.
model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum PricingCategory {
  TOOLING
  BASE
  COPPER_THICKNESS
  SURFACE_FINISH
  SUBSTRATE_THICKNESS
  LEAD_TIME
  QTY_SLAB
  PANELIZATION
}

// One row = one resolvable rate for one (category, key) pair. Single generic
// table (not 7 separate ones) so the admin UI is one CRUD screen with a
// category filter, and adding a future pricing dimension is a new enum value
// + rows, not a new table + new API route.
model PricingRate {
  id          String          @id @default(cuid())
  category    PricingCategory
  key         String // e.g. "2" (layers), "ENIG" (finish), "2 oz" (copper), "1.6mm" (thickness), "express", "100" (qty slab)
  label       String // human-readable label for the admin UI
  value       Decimal         @db.Decimal(10, 2) // meaning depends on unit: flat INR, INR/cm2, or a percent
  unit        String // "INR_FLAT" | "INR_PER_CM2" | "PERCENT_SURCHARGE" | "PERCENT_DISCOUNT"
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  updatedAt   DateTime        @updatedAt
  updatedById String?
  updatedBy   User?           @relation("PricingRateEditedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([category, key])
  @@map("pricing_rates")
}

enum OrderStatus {
  QUOTE
  PENDING_REVIEW
  AWAITING_PAYMENT
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  CANCELLED
}

// How the fabricated boards should be delivered:
// - INDIVIDUAL: single boards, no panelization (default, existing behavior)
// - PANEL_BY_CUSTOMER: customer supplies an already-panelized Gerber set
// - PANEL_BY_PROPCB: we panelize on the customer's behalf, for a fixed fee
//   (PricingRate category PANELIZATION, admin-editable)
enum DeliveryFormat {
  INDIVIDUAL
  PANEL_BY_CUSTOMER
  PANEL_BY_PROPCB
}

// Backs the human-readable, date-encoded order reference (PCB-YYYYMMDD-NNNN).
// One row per day (IST) — `lastValue` is incremented atomically via upsert
// in src/lib/order-reference.ts so concurrent order placements on the same
// day never collide.
model OrderSequence {
  period    String @id // "YYYYMMDD" in IST
  lastValue Int    @default(0)

  @@map("order_sequences")
}

model Order {
  id             String         @id @default(cuid())
  reference      String         @unique // human-facing order ID — PCB-YYYYMMDD-NNNN, see src/lib/order-reference.ts
  userId         String
  status         OrderStatus    @default(QUOTE)
  deliveryFormat DeliveryFormat @default(INDIVIDUAL)

  fileName       String? // original filename, e.g. "board_v2.zip"
  gerberFilePath String? // storage path relative to uploads/orders/, e.g. "<uuid>.<ext>" — see src/lib/order-files.ts
  gerberFileType String? // best-effort MIME type
  gerberFileSize Int? // bytes
  widthMm        Decimal @db.Decimal(10, 2)
  heightMm       Decimal @db.Decimal(10, 2)
  layers         String
  qty            Int
  finish         String
  color          String
  copperWeight   String
  thickness      String
  express        Boolean @default(false)

  // Snapshot of the resolved price breakdown at order time — historical
  // orders must NOT silently reprice when an admin edits a PricingRate later.
  priceBreakdown Json
  total          Decimal @db.Decimal(10, 2) // denormalized for cheap sort/filter

  // Snapshots of the chosen Address rows at order time — same reasoning as
  // priceBreakdown: Address is editable/deletable by the customer, so a
  // live foreign key would let past orders silently change or break. Shape
  // matches Address minus id/userId/type/isDefault/timestamps.
  deliveryAddress Json? // required to place an order (not to save a quote); null for quotes and pre-existing orders
  billingAddress  Json? // optional — not every customer needs a GST invoice

  // Razorpay payment fields. `status` itself is the source of truth for
  // "is this paid" (AWAITING_PAYMENT -> IN_PRODUCTION is the paid
  // transition) — these are just the Razorpay identifiers for reference/
  // reconciliation, not a second state machine. razorpayOrderId is
  // overwritten if the customer retries a failed/abandoned payment attempt.
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  messageThread MessageThread?
  // Optional — a CamJob may be linked to the order it was worked for
  // (set by the user from the CAM tool), but most CamJobs are scratch/
  // internal work with no order at all. onDelete: SetNull on CamJob's side
  // — deleting an order must not delete someone's saved CAM work.
  camJobs       CamJob[]
  shareBundles  ShareBundle[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

enum ThreadType {
  ORDER
  GENERAL_INQUIRY
}

model MessageThread {
  id          String     @id @default(cuid())
  type        ThreadType @default(ORDER)
  orderId     String?    @unique
  subject     String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt // bumped on every new message, for "most recently active" sort

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("message_threads")
}

model Message {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  readAt    DateTime?

  // One image attachment per message (screenshots) — stored on local disk
  // for now (see src/lib/attachments.ts), path is relative to the upload
  // root and includes the threadId so access-control can be checked from
  // the path alone without a DB round trip in the serving route.
  attachmentPath String?
  attachmentName String?
  attachmentType String?
  attachmentSize Int?

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@map("messages")
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String   @db.Text // Markdown
  tag         String // e.g. "Design Tips", "Manufacturing", "Materials", "Basics", "Advanced", "Case Study"
  readMinutes Int      @default(5)
  published   Boolean  @default(true)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@map("blog_posts")
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  price       Decimal     @db.Decimal(10, 2)
  category    String // "Microcontroller", "Interface", "RF / Wireless", "Power", "Sensors", "Displays"
  icon        String // emoji/short glyph, matches the existing shop's visual style
  stockStatus StockStatus @default(IN_STOCK)
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orderItems ShopOrderItem[]

  @@index([isActive])
  @@map("products")
}

enum ShopOrderStatus {
  PENDING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

// Shop (module store) purchases — a separate order concept from the PCB
// fabrication `Order` model above. Payment happens immediately at checkout
// (no DRC-equivalent review step for off-the-shelf modules), unlike PCB
// orders which only reach a payable state after staff review.
model ShopOrder {
  id        String          @id @default(cuid())
  reference String          @unique // SHOP-YYYYMMDD-NNNN, see src/lib/order-reference.ts
  userId    String
  status    ShopOrderStatus @default(PENDING_PAYMENT)

  // Denormalized total for cheap sort/filter, same reasoning as Order.total.
  total Decimal @db.Decimal(10, 2)

  // Snapshot of the chosen Address row at checkout time — same reasoning as
  // Order.deliveryAddress (Address is editable/deletable by the customer).
  deliveryAddress Json

  // Razorpay payment fields — same shape/reasoning as on Order.
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?
  paidAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items ShopOrderItem[]

  @@index([userId])
  @@index([status])
  @@map("shop_orders")
}

model ShopOrderItem {
  id          String  @id @default(cuid())
  shopOrderId String
  productId   String?
  // Snapshot at purchase time — a Product can be edited/deactivated/deleted
  // later without changing what a past order says the customer bought.
  name        String
  price       Decimal @db.Decimal(10, 2) // unit price snapshot
  qty         Int

  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([shopOrderId])
  @@map("shop_order_items")
}

model Testimonial {
  id            String   @id @default(cuid())
  customerName  String
  customerTitle String? // e.g. "CTO, Widgets Inc." — optional
  quote         String   @db.Text
  rating        Int      @default(5) // 1-5
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@map("testimonials")
}

// PRIVATE — owned by one user, only they can see/edit it (Address-book pattern).
// SHARED  — published by staff, readable by everyone (incl. logged-out users),
//           writable only by ADMIN/ENGINEER (Blog/Product pattern).
enum DfmTemplateScope {
  PRIVATE
  SHARED
}

// A named set of manufacturing rule thresholds a Gerber set can be checked
// against. Deliberately NOT a single global capability table: users maintain
// several of their own (e.g. one per target fab), on top of the staff-published
// SHARED ones. See DFM_DRC_ROADMAP.md §4.
model DfmTemplate {
  id     String           @id @default(cuid())
  scope  DfmTemplateScope @default(PRIVATE)
  userId String? // owner of a PRIVATE template; null for the seeded system one
  name   String

  // The DfmRules object (src/lib/dfm/types.ts). A JSON blob rather than
  // normalized rows because the rule set is small and *closed* (~10 known
  // keys) — unlike PricingRate's open-ended slabs — so this avoids a migration
  // every time a rule is added, matching how priceBreakdown/address snapshots
  // are already stored. Always validated through parseDfmRules() before use.
  rules Json

  // PRIVATE: the owner's default pick (unique per userId).
  // SHARED:  the single global default used when a user has no preference.
  isDefault Boolean @default(false)
  // The seeded "ProEmbSys Standard" baseline — cannot be deleted, so there is
  // always at least one selectable template.
  isSystem  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scope])
  @@map("dfm_templates")
}

// A separate enum from DfmTemplateScope even though the values are identical
// today — sharing a Postgres enum would couple two unrelated features'
// migrations, and this name matches the existing per-feature convention.
enum PanelTemplateScope {
  PRIVATE
  SHARED
}

// The reusable "shop policy and machine facts" a customer re-enters on every
// panelization job — rib widths, tooling/fiducial sizes, drill format, output
// format, routing (bit/tabs/mouse-bites), G-code (feeds/depths/spindle), and
// Multi-Panel Array CNC batch settings. Deliberately does NOT store panel
// row/column/gap (the genuine per-job input) or xyOverrides (keyed to one
// panel's own generated hole/fiducial ids) — see
// src/lib/panel-template/types.ts's PanelSectionSettings.
model PanelTemplate {
  id     String             @id @default(cuid())
  scope  PanelTemplateScope @default(PRIVATE)
  userId String? // owner of a PRIVATE template; null for the seeded system one
  name   String

  // ResolvedPanelTemplateSettings, but every section/field OPTIONAL on the way
  // in (src/lib/panel-template/types.ts) — a JSON blob for the same reason
  // DfmTemplate.rules is one, except here EVERY field is optional from day
  // one so a new config field never needs a migration or backfill. Always
  // validated through parsePanelTemplateSettings()/…Safe() before use.
  settings Json

  // PRIVATE: the owner's default pick (unique per userId).
  // SHARED:  the single global default used when a user has no preference.
  isDefault Boolean @default(false)
  // The seeded baseline — cannot be deleted, so there is always at least one
  // selectable template.
  isSystem  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scope])
  @@map("panel_templates")
}

// DRAFT -> READY -> SENT_TO_FAB is the common path, but a job can jump to
// ARCHIVED from any state (abandoning a scratch job) — see the deliberate
// absence of a pipeline/timeline concept in src/lib/cam-job-status.ts.
enum CamJobStatus {
  DRAFT
  READY
  SENT_TO_FAB
  ARCHIVED
}

// A saved snapshot of the CAM Panelization tool's working state, so a
// logged-in user can pick up a job later instead of losing it on refresh.
// No scope/isSystem concept (unlike DfmTemplate/PanelTemplate) — this is
// personal work-in-progress, never a shared/published resource, so userId
// is required (not nullable) with a hard Cascade on delete.
model CamJob {
  id     String @id @default(cuid())
  userId String
  name   String

  // Denormalized out of `config.panelInfo.revision` (trimmed) purely so a
  // (name, revision) pair can be enforced unique per user at the DB level —
  // "always save as new" still holds for every other case, this only blocks
  // a byte-identical name+revision collision, which is almost always an
  // accidental re-save rather than an intentional new job. Kept in sync with
  // `config` at write time; never read back into the snapshot on load.
  revision String @default("")

  // User-controlled workflow state — independent of the `dfm*`/`export*`
  // health columns below. Status is "where is this job in MY process";
  // health is "did the last save look OK" — see src/lib/cam-job-health.ts's
  // own header for why these must never be merged into one field.
  status  CamJobStatus @default(DRAFT)
  // Optional link to the order this job was worked for — set by the user
  // from the CAM tool, most jobs have none. onDelete: SetNull, not Cascade:
  // deleting an order must never delete someone's saved CAM work.
  orderId String?

  // Health snapshot, captured ONCE at save time from live store state
  // (handleSaveJob in export-panel.tsx) — see src/lib/cam-job-health.ts for
  // the full derivation. Columns, not JSON, because the job library filters
  // and sorts on these (the Order.total precedent — a denormalized column
  // for what's queried — not Order.priceBreakdown, which is JSON because
  // it's open-ended and never queried into).
  //
  // dfmRanAt/exportRanAt are nullable DateTimes, not booleans or zero
  // counts: null means "never ran", which is NOT the same fact as "ran and
  // found nothing" — deriveCamJobHealth's #1 rule depends on being able to
  // tell those apart, or an unchecked job would show a false-clean badge.
  dfmRanAt       DateTime?
  dfmErrors      Int?
  dfmWarnings    Int?
  dfmInfos       Int?
  // The layer count DFM ran against, compared at read time to
  // config.files.length to detect a report that predates the current layer
  // set — dfmReport is NOT cleared by addLayer/removeLayer (only by
  // clearLayers/loadCamJobSnapshot), so this can legitimately drift.
  dfmLayerCount  Int?
  exportRanAt    DateTime?
  exportWarnings Int?
  // Import warnings have no "ranAt" — an import either happened (this job
  // has files) or didn't, so a bare count is enough; @default(0) rather
  // than nullable, unlike the DFM/export fields above.
  importWarnings Int       @default(0)

  // CamJobSnapshot (src/lib/store.ts) — flat CAM config slices (panelConfig,
  // routingConfig, gcodeContext, panelArrayConfig, stencilConfig, designs,
  // panelInfo, etc.) plus a `files[]` metadata array (fileName, designId,
  // type, side, color, visible, opacity, fileSize per layer). File CONTENT
  // is never duplicated here — it lives on disk under uploads/cam-jobs/<id>/,
  // see src/lib/cam-job-files.ts. Never includes computed/derived state
  // (panelResult, routingResult, gcodeFiles, dfmReport, ...) — those are
  // recomputed by the user re-clicking Create Panel/Generate Routing/etc.
  // after a load, matching the tool's existing "nothing auto-computes"
  // convention. The status/health fields above are ALSO deliberately kept
  // out of this blob for the same reason as priceBreakdown vs total on
  // Order: what's queried needs to be a column, not buried in JSON.
  config Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  shareBundles ShareBundle[]

  @@unique([userId, name, revision])
  // Superset of the old bare @@index([userId]) — every list view sorts by
  // updatedAt desc, so this covers both the old lookup and that sort.
  @@index([userId, updatedAt])
  @@index([orderId])
  @@map("cam_jobs")
}
