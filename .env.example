DATABASE_URL="postgresql://propcb:propcb_dev_password@localhost:5432/propcb?schema=public"
AUTH_SECRET="run: openssl rand -base64 32"
APP_URL="http://localhost:3000"
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="ProPCB <noreply@yourdomain.com>"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxx"

# Optional — absolute path for local-disk uploads (cam-jobs/messages/orders/
# shares). Defaults to <cwd>/uploads, which is fine for `next dev` but is a
# real risk for `output: "standalone"` production builds: the standalone
# server's cwd can differ from the source tree, so an emailed share link
# built against the dev-time path can 404 in production. Set this to an
# absolute, persistent path when deploying standalone.
# UPLOADS_DIR="/var/lib/propcb/uploads"
SHARE_ATTACH_MAX_BYTES="6291456"
SHARE_RATE_PER_HOUR="20"
# Set to skip actually calling Resend — writes the rendered email HTML/text
# to a scratch file instead, for iterating on templates without burning quota.
SHARE_EMAIL_DRY_RUN=""
