DATABASE_URL="postgresql://propcb:propcb_dev_password@localhost:5432/propcb?schema=public"
AUTH_SECRET="run: openssl rand -base64 32"
APP_URL="http://localhost:3000"

# Email — src/lib/email.ts picks a provider at EMAIL_PROVIDER (default
# "gmail" when unset; set to "resend" to use Resend instead). Both are kept
# working at once — this is a switch, not a migration — so moving back to
# Resend later (e.g. once a sending domain is verified) is a one-line change.
EMAIL_PROVIDER="gmail"
# Gmail path: a Google Account with 2-Step Verification on, then an App
# Password from Google Account -> Security -> App Passwords (NOT your normal
# Gmail password — that will be rejected). GMAIL_USER must be the same
# address that generated the App Password.
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
# Resend path (EMAIL_PROVIDER="resend"):
RESEND_API_KEY="re_xxxxxxxx"
# Shown as the From name/address on every outgoing email — but on the Gmail
# path, Gmail's own SMTP server rewrites/rejects a From that doesn't match
# GMAIL_USER, so set this to "ProPCB <your-gmail-address>" while
# EMAIL_PROVIDER="gmail". Only fully honored on the Resend path.
EMAIL_FROM="ProPCB <noreply@yourdomain.com>"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxx"

# Optional — absolute path for local-disk uploads (cam-jobs/messages/orders/
# shares). Defaults to <cwd>/uploads, which is fine for `next dev` but is a
# real risk for `output: "standalone"` production builds: the standalone
# server's cwd can differ from the source tree, so an emailed share link
# built against the dev-time path can 404 in production. Set this to an
# absolute, persistent path when deploying standalone.
# UPLOADS_DIR="/var/lib/propcb/uploads"
SHARE_ATTACH_MAX_BYTES="6291456"
SHARE_RATE_PER_HOUR="20"
# Set to skip actually calling Resend — writes the rendered email HTML/text
# to a scratch file instead, for iterating on templates without burning quota.
SHARE_EMAIL_DRY_RUN=""
